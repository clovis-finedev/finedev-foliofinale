{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python",
      "config": {
        "runtime": "python3.9",
        "maxLambdaSize": "15mb",
        "includeFiles": "templates/**"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/cv.pdf",
      "dest": "/public/cv.pdf",
      "headers": {
        "Content-Type": "application/pdf"
      }
    },
    {
      "src": "/converter",
      "dest": "app.py",
      "methods": ["GET"]
    },
    {
      "src": "/submit_contact",
      "dest": "app.py",
      "methods": ["POST"]
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "rewrites": [
    {
      "source": "/portfolio",
      "destination": "/"
    }
  ]
}
